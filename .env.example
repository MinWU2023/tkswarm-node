# 客服端 Node：不连数据库，业务数据走 PHP API
TKSWARM_API_BASE=http://tkswarm-api.dyyweb.com
# 可选：后台任务/轮询用的登录 token（也可写在 config/api.json 的 token）
# TKSWARM_API_TOKEN=

# 环境包租约 WSS 中继地址（可选，默认使用服务端下发的 TKSWARM_RELAY_PUBLIC_URL）
# TKSWARM_RELAY_URL=wss://tkswarm-api.dyyweb.com/ws-relay

TKSWARM_PORT=8999
TKSWARM_HOST=127.0.0.1
BIT_API_URL=http://127.0.0.1:54345
# BIT_API_TOKEN=

# 人类操作节奏（降低验证触发）：默认 1.7 = 整体放慢约 70%
# 建议范围 1.5~2.2；设 1.0 恢复原速度
# TKSWARM_HUMAN_PACE=1.7
# 同账号敏感动作（发信/发布）最小间隔毫秒，默认 8000
# TKSWARM_ACTION_GAP_MS=8000
